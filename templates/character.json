{
    "$schema": "https://json-schema.org/draft-07/schema",
    "type": "object",
    "required": [
        "name",
        "appearance",
        "personality",
        "skills",
        "background"
    ],
    "properties": {
        "name": {
            "type": "string",
            "description": "The name of the character"
        },
        "appearance": {
            "type": "string",
            "description": "A comma-separated list of the character's current visual traits, including baseline features (hair color and style, eye color, skin color, perceived gender, build), permanent modifications (scars, tattoos, body shape changes like breast size), and active temporary states (flushing, dirt, sweat, bruises, posture)."
        },
        "personality": {
            "type": "string",
            "description": "Comma separated personality traits"
        },
        "skills": {
            "type": "string",
            "description": "Comma separated skills and competencies"
        },
        "background": {
            "type": "string",
            "description": "A summarized origin story"
        }
    }
}