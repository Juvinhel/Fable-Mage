{
    "$schema": "https://json-schema.org/draft-07/schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "name": {
            "type": "string",
            "description": "The name of the character"
        },
        "appearance": {
            "type": "string",
            "description": "Comma separated list of visual appearance tags"
        },
        "personality": {
            "type": "string",
            "description": "Comma separated personality traits"
        },
        "skills": {
            "type": "string",
            "description": "Comma separated skills and competencies"
        },
        "background": {
            "type": "string",
            "description": "A summarized origin story"
        }
    }
}