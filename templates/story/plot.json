{
    "$schema": "https://json-schema.org/draft-07/schema",
    "type": "object",
    "required": [
        "plot",
        "time",
        "location",
        "internal"
    ],
    "properties": {
        "plot": {
            "type": "string",
            "description": "The main narrative output presented to the player"
        },
        "time": {
            "type": "string",
            "description": "Current time of the scene"
        },
        "location": {
            "type": "string",
            "description": "Current location of the scene"
        },
        "internal": {
            "type": "string",
            "description": "Internal continuity log of events, motivations, plans and environmental changes"
        }
    }
}