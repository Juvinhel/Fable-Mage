{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "NPM Install",
            "type": "shell",
            "command": "npm i",
        },
        {
            "label": "Init dist",
            "dependsOn": [
                "Create dist",
            ],
            "command": "Remove-Item",
            "type": "shell",
            "args": [
                "dist/*",
                "-Recurse",
                "-Force"
            ],
            "hide": true,
        },
        {
            "label": "Create dist",
            "type": "shell",
            "command": "New-Item",
            "args": [
                "-ItemType",
                "Directory",
                "-Force",
                "-Path",
                "dist"
            ],
            "hide": true,
        },
        {
            "label": "Build Typescript",
            "type": "typescript",
            "tsconfig": "tsconfig.json",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$tsc"
            ],
        },
        {
            "label": "Build LESS",
            "command": "LessBuilder",
            "type": "shell",
            "args": [
                "-c",
                "lessconfig.json",
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
        },
        {
            "label": "Copy Modules",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "modules/**/*.min.js",
                "-Destination",
                "dist",
                "-Force"
            ],
            "hide": true,
        },
        {
            "label": "Copy Index",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "index.html,",
                "img/favicon.svg,",
                "img/favicon.png,",
                "img/favicon.ico,",
                "manifest.json",
                "-Destination",
                "dist",
                "-Force"
            ],
            "hide": true,
        },
        {
            "label": "Copy Fonts",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "fonts",
                "-Destination",
                "dist",
                "-Force",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Copy Images",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "img,node_modules\\@peach\\ui\\img",
                "-Destination",
                "dist",
                "-Force",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Copy Templates",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "templates",
                "-Destination",
                "dist",
                "-Force",
                "-Recurse",
            ],
            "hide": true,
        },
        {
            "label": "Generate Version",
            "command": "GenVersion -o dist/manifest.json -t manifest.json",
            "type": "shell",
            "hide": true,
        },
        {
            "label": "Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Init dist",
                "Build Typescript",
                "Build LESS",
                "Copy Modules",
                "Copy Index",
                "Copy Fonts",
                "Copy Images",
                "Copy Templates",
                "Generate Version",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Init publish",
            "dependsOn": [
                "Create publish",
            ],
            "command": "Remove-Item",
            "type": "shell",
            "args": [
                "publish/*",
                "-Recurse",
                "-Force"
            ],
            "hide": true,
        },
        {
            "label": "Create publish",
            "type": "shell",
            "command": "New-Item",
            "args": [
                "-ItemType",
                "Directory",
                "-Force",
                "-Path",
                "publish"
            ],
            "hide": true,
        },
        {
            "label": "Copy dist to publish",
            "command": "Copy-Item",
            "type": "shell",
            "args": [
                "-Path",
                "dist/*",
                "-Destination",
                "publish",
                "-Force",
                "-Recurse"
            ],
            "hide": true,
        },
        {
            "label": "Build ServiceWorker",
            "command": "workbox generateSW workbox-config.js",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "hide": true,
        },
        {
            "label": "Zip publish",
            "type": "shell",
            "command": "Compress-Archive",
            "args": [
                "-Path",
                "publish/*",
                "-DestinationPath",
                "publish/web.zip"
            ],
            "hide": true,
        },
        {
            "label": "Clean publish folder",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "Get-ChildItem -Path 'publish' -File | Where-Object Name -ne \\\"web.zip\\\" | Remove-Item -Force; Get-ChildItem -Path 'publish' -Directory | Remove-Item -Recurse -Force"
            ],
            "hide": true,
        },
        {
            "label": "Publish",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build",
                "Init publish",
                "Copy dist to publish",
                "Build ServiceWorker",
                "Zip publish",
                "Clean publish folder"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
        },
    ]
}